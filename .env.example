
# --- Tiered AI API infrastructure ---
# Hard monthly estimated spend cap across all model providers.
MAX_AI_MONTHLY_USD=30

# Keep false until admin/manual buttons are wired and tested.
ENABLE_AI_GATEWAY=false

# Optional. If set, protected API endpoints require x-admin-api-key.
ADMIN_API_KEY=

# Existing strong model provider.
ANTHROPIC_API_KEY=
ANTHROPIC_STRONG_MODEL=claude-sonnet-4-6
ANTHROPIC_MEDIUM_MODEL=claude-haiku-4-5-20251001

# Cheap clerk model provider. Recommended first clerk model.
GEMINI_API_KEY=
GEMINI_CHEAP_MODEL=gemini-2.5-flash-lite

# Optional cheap clerk fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_CHEAP_MODEL=deepseek-v4-flash

# Feature flags.
ENABLE_CHEAP_CLERK_MODEL=true
ENABLE_CLAUDE_RISK_REVIEW=true
ENABLE_AI_MISSING_FIELD_RESEARCH=false
ENABLE_AI_SOCIAL_GENERATION=false
